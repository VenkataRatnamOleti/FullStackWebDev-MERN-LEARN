<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit this Chat</title>
  </head>
  <body>
    <h3>Edit Your Message</h3>
    <form action="/chats/<%= chat.id %>?_method=PATCH" method="post">
      <textarea name="message" id="messasge"><%= chat.message %></textarea>
      <br />
      <button>Update</button>
    </form>
  </body>
</html>
