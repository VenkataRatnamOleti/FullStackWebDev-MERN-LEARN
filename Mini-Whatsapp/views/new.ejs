<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create New Chat</title>
  </head>
  <body>
    <h3>Add New Message</h3>
    <form action="/chats" method="post">
      <input type="text" placeholder="Enter Sender's Name" name="from" /> <br />
      <input type="text" placeholder="Enter Receiver's Name" name="to" /> <br />
      <textarea
        name="message"
        id="message"
        placeholder="Enter your message here.."
      ></textarea>
      <br />
      <button>Add</button>
    </form>
  </body>
</html>
